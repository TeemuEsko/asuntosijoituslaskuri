# Tarvitaan myynti-ilmoituksen ja käyttäjän lisäämien kohdekuvien visuaaliseen kuntoarvioon.
OPENAI_API_KEY=

# Valinnainen. Oletus on gpt-5.6.
VISUAL_CONDITION_MODEL=gpt-5.6

# Automaattinen ilmoituskuvien analyysi on oletuksena pois käytöstä.
# Ota käyttöön vasta, kun OpenAI-käsittely, tietosuojateksti ja oikeusperuste on hyväksytty.
ENABLE_LISTING_IMAGE_ANALYSIS=false

# Valinnainen. Lisää vain erikseen tarkistetut, pilkulla erotellut kuva-CDN-isäntänimet.
# Oletuslistat kattavat Etuoven ja Oikotien tunnetut omat kuvalähteet.
LISTING_IMAGE_HOSTS_ETUOVI=
LISTING_IMAGE_HOSTS_OIKOTIE=

# Valinnainen. Kajabin maksuttoman koulutuksen julkinen URL.
# Sovellus käyttää oletuksena nykyistä koulutuslinkkiä, jos arvo puuttuu.
NEXT_PUBLIC_KAJABI_TRAINING_URL=

# Valinnainen. Henkilökohtaisen asiantuntija-arvion julkinen URL.
# Oletus: https://www.teemuesko.fi/offers/oQURChtb
NEXT_PUBLIC_PROFESSIONAL_EVALUATION_URL=

# Vain vanhaa liiditallennusta ja ylläpitotyökaluja varten. Maksuton analyysi ei tarvitse tietokantaa.
DATABASE_URL=

# Pakollinen vain suojattuun Kajabi-CSV-vientiin. Vähintään 32 merkin satunnainen bearer-token.
LEAD_EXPORT_ADMIN_TOKEN=

# Pakolliset tietosuojaselosteen omistajatiedot ennen tuotantojulkaisua.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT=
PRIVACY_RETENTION_PERIOD=
PRIVACY_INTERNATIONAL_TRANSFERS=
